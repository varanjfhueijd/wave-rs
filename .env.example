# Copier vers .env et remplir — ne JAMAIS committer un .env avec de vraies clés.

# Wave
WAVE_API_KEY=
WAVE_MERCHANT_ID=
WAVE_SANDBOX=true

# Orange Money CI
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SANDBOX=true

# MTN MoMo
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_SANDBOX=true

# Moov Africa
MOOV_API_KEY=
MOOV_SANDBOX=true

# --- Tests live (optionnel) ---
# Activent les tests contre les vraies APIs sandbox :
#   WAVE_LIVE_TESTS=true cargo test --test live -- --ignored
# Sans ces variables, les tests live skippent proprement.
WAVE_LIVE_TESTS=false
WAVE_TEST_MSISDN=
ORANGE_TEST_MSISDN=
MTN_TEST_MSISDN=
MOOV_TEST_MSISDN=
